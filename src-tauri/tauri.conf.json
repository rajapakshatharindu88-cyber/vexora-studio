{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VEXORA Studio",
  "version": "1.0.0",
  "identifier": "studio.vexora.desktop",
  "build": {
    "beforeDevCommand": "python3 -m http.server 4173 --directory web",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VEXORA Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Graphics",
    "shortDescription": "Offline-first vector design studio",
    "longDescription": "An original lightweight vector design editor with offline smart design tools.",
    "license": "MIT",
    "createUpdaterArtifacts": false
  }
}
